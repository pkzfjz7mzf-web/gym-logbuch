<bpmn:sequenceFlow id="f12" sourceRef="T_start2" targetRef="G_m1"/>
<bpmn:sequenceFlow id="f13" sourceRef="T_start3" targetRef="G_m1"/>
<bpmn:sequenceFlow id="f14" sourceRef="G_m1" targetRef="T_offer"/>
<bpmn:sequenceFlow id="f15" sourceRef="T_offer" targetRef="G_accept"/>
<bpmn:sequenceFlow id="f16" name="ja" sourceRef="G_accept" targetRef="G_m2"/>
<bpmn:sequenceFlow id="f17" name="nein" sourceRef="G_accept" targetRef="U_manual"/>
<bpmn:sequenceFlow id="f18" sourceRef="G_m2" targetRef="U_probe"/>
<bpmn:sequenceFlow id="f19" sourceRef="U_probe" targetRef="U_rate"/>
<bpmn:sequenceFlow id="f20" sourceRef="U_rate" targetRef="G_rate"/>
<bpmn:sequenceFlow id="f21" name="im Ziel" sourceRef="G_rate" targetRef="T_found"/>
<bpmn:sequenceFlow id="f22" name="darunter oder Technik wackelte" sourceRef="G_rate" targetRef="T_down"/>
<bpmn:sequenceFlow id="f23" name="darüber" sourceRef="G_rate" targetRef="G_count"/>
<bpmn:sequenceFlow id="f24" name="nein" sourceRef="G_count" targetRef="T_next"/>
<bpmn:sequenceFlow id="f25" sourceRef="T_next" targetRef="G_m2"/>
<bpmn:sequenceFlow id="f26" name="ja" sourceRef="G_count" targetRef="T_take"/>
<bpmn:sequenceFlow id="f27" sourceRef="T_found" targetRef="G_m3"/>
<bpmn:sequenceFlow id="f28" sourceRef="T_down" targetRef="G_m3"/>
<bpmn:sequenceFlow id="f29" sourceRef="T_take" targetRef="G_m3"/>
<bpmn:sequenceFlow id="f30" sourceRef="U_manual" targetRef="G_m3"/>
<bpmn:sequenceFlow id="f31" sourceRef="G_m3" targetRef="T_fill"/>
<bpmn:sequenceFlow id="f32" sourceRef="T_fill" targetRef="U_work"/>
<bpmn:sequenceFlow id="f33" sourceRef="U_work" targetRef="T_save"/>
<bpmn:sequenceFlow id="f34" sourceRef="T_save" targetRef="E_done"/>
<bpmn:dataStoreReference id="DS_in" name="Verlauf"/>
<bpmn:dataStoreReference id="DS_out" name="Verlauf"/>
</bpmn:process>
